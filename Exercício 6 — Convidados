import java.util.LinkedList;

class Convidado {
    String nome, cpf;

    Convidado(String n, String c) {
        nome = n;
        cpf = c;
    }

    public String toString() {
        return nome + " - " + cpf;
    }
}

public class Ex6 {
    public static void main(String[] args) {
        LinkedList<Convidado> lista = new LinkedList<>();

        for (int i = 1; i <= 6; i++)
            lista.add(new Convidado("Pessoa" + i, "CPF" + i));

        System.out.println(lista);
        System.out.println("Contém Pessoa3? " + lista.toString().contains("Pessoa3"));
        System.out.println("Total: " + lista.size());
    }
}
